    box-shadow:0 24px 60px rgba(0,0,0,.42),inset 0 0 0 1px rgba(255,255,255,.05);
    color:#f8fafc;
  }

  .lx-mainbox:before{
    content:"";
    position:absolute;
    inset:16px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:20px;
    pointer-events:none;
  }

  .lx-mainbox:after{
    content:"";
    position:absolute;
    top:-80px;
    right:-100px;
    width:260px;
    height:260px;
    border-radius:50%;
