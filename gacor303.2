    justify-content: center;
    flex-wrap: wrap;
}

.btn-gold {
    display: inline-block;
    min-width: 125px;
    padding: 12px 28px;
    border-radius: 40px;
    font-size: 14px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    transition: .25s ease;
}

.btn-login-gold {
    color: #FFC6FF;
    border: 1px solid #FFC6FF;
    background: transparent;
}

.btn-register-gold {
    color: #111;
    border: 1px solid #FFC6FF;
    background: linear-gradient(135deg, #fff3a0, #FFC6FF);
}

.btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(255,217,0,.25);
}

