$found = false;

foreach ($pages as $i => $page) {

    if (trim($page,'/') === $requestUri) {

        $PAGE = trim($page,'/');
        $BRANDS = $brands[$i] ?? '';
        $TITLE = $titles[$i] ?? '';
        $DESCRIPTION = $descs[$i] ?? '';

        $CANONICAL = rtrim($BASE_URL,'/') . '/' . $PAGE . '/';

        $found = true;

        break;
